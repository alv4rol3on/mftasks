# =========================================================
# Configuración de ejemplo. Copiar a .env y completar.
# NUNCA subir .env al repositorio.
# =========================================================

# --- Django ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,192.168.202.10

# Orígenes permitidos (esquema + host + puerto, separados por coma).
# Para HTTPS usar https://...
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.202.10:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://192.168.202.10:3000

# Activar solo si hay un proxy TLS delante.
DJANGO_BEHIND_PROXY=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_HSTS_SECONDS=0

# Duración de tokens JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=12

# --- Microsoft Entra ID (SSO) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Dominio(s) corporativos permitidos, separados por coma. Recomendado no dejarlo vacío.
AZURE_ALLOWED_DOMAINS=empresa.com

# --- Microsoft Graph (correo corporativo) ---
MAIL_TENANT_ID=
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_SENDER=

# --- Correo transaccional ---
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Sistema de Solicitudes <no-reply@empresa.com>

# --- Frontend ---
NEXT_PUBLIC_CLIENT_ID=
NEXT_PUBLIC_TENANT_ID=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_WS_SAME_ORIGIN=false
